  <samplerData class="java.lang.String">import java.sql.Connection
import java.sql.DriverManager
import java.sql.ResultSet

def P = { k, d -&gt; (vars.get(k) ?: props.getProperty(k) ?: d) }
String host = P(&apos;db_host&apos;, &apos;&apos;)
String port = P(&apos;db_port&apos;, &apos;5432&apos;)
String db   = P(&apos;db_name&apos;, &apos;postgres&apos;)
String user = P(&apos;db_user&apos;, &apos;&apos;)
String pwd  = P(&apos;db_password&apos;, &apos;&apos;)
String ssl  = P(&apos;db_sslmode&apos;, &apos;require&apos;)

String url = &apos;jdbc:postgresql://&apos; + host + &apos;:&apos; + port + &apos;/&apos; + db + &apos;?sslmode=&apos; + ssl
String stamp = new Date().format(&apos;yyyyMMdd_HHmmss&apos;)
File outDir = new File(&apos;results&apos;); outDir.mkdirs()
StringBuilder out = new StringBuilder()

def runQuery = { Connection c, String title, String sql, String fileName -&gt;
    out.append(&apos;=== &apos; + title + &apos; ===\n&apos;)
    File f = new File(outDir, fileName + &apos;_&apos; + stamp + &apos;.csv&apos;)
    ResultSet rs = c.createStatement().executeQuery(sql)
    int cols = rs.metaData.columnCount
    List hdr = (1..cols).collect { rs.metaData.getColumnName(it) }
    out.append(hdr.join(&apos; | &apos;) + &apos;\n&apos;)
    f.withWriter { w -&gt;
        w.writeLine(hdr.join(&apos;,&apos;))
        while (rs.next()) {
            List row = (1..cols).collect { String.valueOf(rs.getObject(it)) }
            out.append(row.join(&apos; | &apos;) + &apos;\n&apos;)
            w.writeLine(row.collect { &apos;&quot;&apos; + it.replace(&apos;&quot;&apos;, &quot;&apos;&quot;) + &apos;&quot;&apos; }.join(&apos;,&apos;))
        }
    }
    out.append(&apos;Saved: &apos; + f.absolutePath + &apos;\n\n&apos;)
}

Class.forName(&apos;org.postgresql.Driver&apos;)
Connection conn = DriverManager.getConnection(url, user, pwd)
try {
    runQuery(conn, &apos;Connections per user and state&apos;,
        &quot;SELECT usename, state, COUNT(*) AS connections, &quot; +
        &quot;MAX(now() - state_change) AS longest_in_state &quot; +
        &quot;FROM pg_stat_activity WHERE datname IS NOT NULL &quot; +
        &quot;GROUP BY usename, state ORDER BY connections DESC&quot;,
        &apos;pls1115_conn_by_user&apos;)

    runQuery(conn, &apos;Per-user timeout overrides (pg_db_role_setting)&apos;,
        &quot;SELECT r.rolname, d.datname, s.setconfig &quot; +
        &quot;FROM pg_db_role_setting s &quot; +
        &quot;LEFT JOIN pg_roles r ON r.oid = s.setrole &quot; +
        &quot;LEFT JOIN pg_database d ON d.oid = s.setdatabase&quot;,
        &apos;pls1115_role_settings&apos;)

    runQuery(conn, &apos;Current timeout settings&apos;,
        &quot;SELECT name, setting, unit FROM pg_settings &quot; +
        &quot;WHERE name IN (&apos;idle_session_timeout&apos;,&apos;idle_in_transaction_session_timeout&apos;,&apos;max_connections&apos;)&quot;,
        &apos;pls1115_timeouts&apos;)
} finally {
    conn.close()
}

SampleResult.setResponseData(out.toString(), &apos;UTF-8&apos;)
SampleResult.setResponseMessage(&apos;RDS baseline queries done&apos;)
SampleResult.setSuccessful(true)</samplerData>
</sample>
