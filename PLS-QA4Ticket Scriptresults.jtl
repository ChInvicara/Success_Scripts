  <samplerData class="java.lang.String">// PLS-1115 RDS monitor + summary - compact version (Groovy 3 safe). Parameters: MONITOR or SUMMARY
import java.sql.Connection
import java.sql.DriverManager
import java.sql.ResultSet
import java.sql.Statement

String MODE = (args != null &amp;&amp; args.length &gt; 0) ? args[0].trim() : &apos;MONITOR&apos;
def P = { String k, String d -&gt;
    String v = vars.get(k.toUpperCase())
    if (v == null || v.trim().isEmpty()) v = props.getProperty(k)
    (v == null || v.trim().isEmpty()) ? d : v.trim()
}
String dbHost  = P(&apos;db_host&apos;, &apos;&apos;)
String dbUser  = P(&apos;db_user&apos;, &apos;&apos;)
String dbPass  = System.getenv(&apos;RDS_PASSWORD&apos;) ?: P(&apos;db_password&apos;, &apos;&apos;)
String dbPort  = P(&apos;db_port&apos;, &apos;5432&apos;)
String dbName  = P(&apos;db_name&apos;, &apos;postgres&apos;)
String sslMode = P(&apos;db_sslmode&apos;, &apos;require&apos;)
int warnPct = P(&apos;warn_pct&apos;, &apos;75&apos;) as int
int failPct = P(&apos;fail_pct&apos;, &apos;90&apos;) as int

String baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
String runDir = (String) props.get(&apos;PLS1115_RESULTS_DIR&apos;)
if (!runDir) {
    runDir = baseDir + File.separator + &apos;results&apos; + File.separator + &apos;run_&apos; + new Date().format(&apos;yyyyMMdd_HHmmss&apos;)
    props.put(&apos;PLS1115_RESULTS_DIR&apos;, runDir)
}
File resultsDir = new File(runDir)
resultsDir.mkdirs()
def now = { new Date().format(&apos;yyyy-MM-dd HH:mm:ss&apos;) }
def q = { Object o -&gt; &apos;&quot;&apos; + String.valueOf(o == null ? &apos;&apos; : o).replace(&apos;&quot;&apos;, &quot;&apos;&quot;) + &apos;&quot;&apos; }
def csv = { String name, List header, List row -&gt;
    File f = new File(resultsDir, name)
    if (!f.exists()) f.append(header.collect { q(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
    f.append(row.collect { q(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
}

// ============================ MONITOR (02 RDS Connection Monitor)
if (MODE == &apos;MONITOR&apos;) {
    if (!dbHost || !dbUser) {
        SampleResult.setResponseMessage(&apos;RDS monitor skipped - db_host / db_user not set&apos;)
        SampleResult.setSuccessful(true)
        return
    }
    Connection c = (Connection) vars.getObject(&apos;PLS1115_CONN&apos;)
    if (c == null || c.isClosed()) {
        Class.forName(&apos;org.postgresql.Driver&apos;)
        String url = &apos;jdbc:postgresql://&apos; + dbHost + &apos;:&apos; + dbPort + &apos;/&apos; + dbName + &apos;?sslmode=&apos; + sslMode + &apos;&amp;connectTimeout=10&amp;ApplicationName=PLS1115-monitor&apos;
        c = DriverManager.getConnection(url, dbUser, dbPass)
        vars.putObject(&apos;PLS1115_CONN&apos;, c)
    }
    Statement st = c.createStatement()
    ResultSet rs = st.executeQuery(&apos;SHOW max_connections&apos;)
    rs.next()
    int maxC = rs.getInt(1)
    rs.close()
    rs = st.executeQuery(&quot;SELECT COALESCE(host(client_addr),&apos;local&apos;), COALESCE(NULLIF(application_name,&apos;&apos;),&apos;-&apos;), COALESCE(usename,&apos;-&apos;), COALESCE(state,&apos;-&apos;), COUNT(*), COALESCE(MAX(EXTRACT(EPOCH FROM (now()-state_change)))::int,0) FROM pg_stat_activity WHERE backend_type = &apos;client backend&apos; AND pid &lt;&gt; pg_backend_pid() GROUP BY 1,2,3,4 ORDER BY 5 DESC&quot;)
    List rows = []
    while (rs.next()) rows &lt;&lt; [ip: rs.getString(1), app: rs.getString(2), user: rs.getString(3), state: rs.getString(4), count: rs.getInt(5), oldest: rs.getInt(6)]
    rs.close()
    rs = st.executeQuery(&apos;SELECT COALESCE(SUM(numbackends),0) FROM pg_stat_database&apos;)
    rs.next()
    int dbTotal = rs.getInt(1) - 1
    rs.close()
    st.close()

    int visible = rows.sum { it.count } ?: 0
    int total = Math.max(visible, dbTotal)
    int idle = rows.findAll { it.state == &apos;idle&apos; }.sum { it.count } ?: 0
    double pct = maxC &gt; 0 ? Math.round(1000.0 * total / maxC) / 10.0 : 0
    Integer prev = (Integer) vars.getObject(&apos;PLS1115_PREV&apos;)
    int delta = prev == null ? 0 : total - prev
    vars.putObject(&apos;PLS1115_PREV&apos;, total)
    Integer pk = (Integer) vars.getObject(&apos;PLS1115_PEAK&apos;)
    int peak = Math.max(pk ?: 0, total)
    vars.putObject(&apos;PLS1115_PEAK&apos;, peak)

    String ts = now()
    if (prev != null &amp;&amp; Math.abs(delta) &gt;= 10)
        csv(&apos;pls1115_ip_events.csv&apos;, [&apos;Timestamp&apos;, &apos;Event&apos;, &apos;Connections&apos;, &apos;Delta&apos;], [ts, delta &gt; 0 ? &apos;CONN_JUMP (pod start?)&apos; : &apos;CONN_DROP (pod stop?)&apos;, total, delta])
    csv(&apos;pls1115_conn_summary.csv&apos;, [&apos;Timestamp&apos;, &apos;TotalConnections&apos;, &apos;Delta&apos;, &apos;IdleConnections&apos;, &apos;MaxConnections&apos;, &apos;UsagePercent&apos;, &apos;PeakSoFar&apos;, &apos;VisibleSessions&apos;],
        [ts, total, delta, idle, maxC, pct, peak, visible])
    rows.each { r -&gt;
        csv(&apos;pls1115_conn_detail.csv&apos;, [&apos;Timestamp&apos;, &apos;ClientIp&apos;, &apos;AppName&apos;, &apos;DbUser&apos;, &apos;State&apos;, &apos;Count&apos;, &apos;OldestIdleSec&apos;],
            [ts, r.ip, r.app, r.user, r.state, r.count, r.oldest])
    }

    String msg = &apos;total=&apos; + total + &apos; (&apos; + pct + &apos;% of &apos; + maxC + &apos;) delta=&apos; + delta + &apos; idle=&apos; + idle + &apos; peak=&apos; + peak
    StringBuilder sb = new StringBuilder(msg + &apos;\n&apos;)
    rows.each { r -&gt; sb.append(String.format(&apos;%-16s %-28s %-24s %-20s %5d conns  oldest %6ds%n&apos;, r.ip, r.user, r.app, r.state, r.count, r.oldest)) }
    log.info(&apos;PLS-1115 &apos; + msg)
    SampleResult.setResponseMessage(msg)
    SampleResult.setResponseData(sb.toString(), &apos;UTF-8&apos;)
    SampleResult.setResponseCode(pct &gt;= failPct ? &apos;CONN_LIMIT&apos; : (pct &gt;= warnPct ? &apos;WARN_HIGH&apos; : &apos;200&apos;))
    SampleResult.setSuccessful(pct &lt; failPct)
    return
}

// ============================ SUMMARY (99 tearDown)
if (MODE == &apos;SUMMARY&apos;) {
    List lines = []
    List checks = []
    File f = new File(resultsDir, &apos;pls1115_conn_summary.csv&apos;)
    if (f.exists()) {
        List data = f.readLines(&apos;UTF-8&apos;).drop(1).findAll { it.trim() }.collect { it.substring(1, it.length() - 1).split(&apos;&quot;,&quot;&apos;, -1) as List }
        if (data) {
            List tot = data.collect { it[1] as int }
            int maxC = data[0][4] as int
            int n = Math.min(4, tot.size())
            int base = (int) Math.round(tot.take(n).sum() / (double) n)
            int fin = (int) Math.round(tot.takeRight(n).sum() / (double) n)
            int peak = tot.max()
            double peakPct = maxC &gt; 0 ? Math.round(1000.0 * peak / maxC) / 10.0 : 0
            lines &lt;&lt; &apos;RDS: max_connections=&apos; + maxC + &apos;  polls=&apos; + data.size() + &apos; (&apos; + data[0][0] + &apos; -&gt; &apos; + data[-1][0] + &apos;)&apos;
            lines &lt;&lt; &apos;Connections: baseline~&apos; + base + &apos;  peak=&apos; + peak + &apos; (&apos; + peakPct + &apos;%)  end~&apos; + fin
            checks &lt;&lt; [&apos;No flat ceiling near the limit (Gary: 376 flat)&apos;, &apos;peak &apos; + peak + &apos;/&apos; + maxC + &apos; = &apos; + peakPct + &apos;%&apos;, peakPct &lt; warnPct ? &apos;OK&apos; : &apos;NOK&apos;]
            checks &lt;&lt; [&apos;Connections return to baseline after load&apos;, &apos;baseline~&apos; + base + &apos;, end~&apos; + fin, fin &lt;= base + Math.max(10, (int) (base * 0.2)) ? &apos;OK&apos; : &apos;NOK&apos;]
        }
    }
    boolean noMon = checks.isEmpty()
    if (noMon) {
        lines &lt;&lt; &apos;No monitor data (db_host / db_user not set, or monitor did not run).&apos;
        checks &lt;&lt; [&apos;RDS connection monitoring&apos;, &apos;NOT RUN&apos;, &apos;PENDING&apos;]
    }
    File ev = new File(resultsDir, &apos;pls1115_ip_events.csv&apos;)
    int jumps = ev.exists() ? ev.readLines(&apos;UTF-8&apos;).count { it.contains(&apos;CONN_JUMP&apos;) } : 0
    int drops = ev.exists() ? ev.readLines(&apos;UTF-8&apos;).count { it.contains(&apos;CONN_DROP&apos;) } : 0
    lines &lt;&lt; &apos;Connection jumps/drops (possible pod start/stop): jumps=&apos; + jumps + &apos; drops=&apos; + drops + &apos; - compare times with SigNoz pod events&apos;
    Object oDb = props.get(&apos;PLS1115_DBERR&apos;)
    Object oErr = props.get(&apos;PLS1115_LOADERR&apos;)
    Object oTot = props.get(&apos;PLS1115_LOADTOTAL&apos;)
    int nDb = oDb == null ? 0 : ((Number) oDb).intValue()
    int nErr = oErr == null ? 0 : ((Number) oErr).intValue()
    int nTot = oTot == null ? 0 : ((Number) oTot).intValue()
    lines &lt;&lt; &apos;Load samples=&apos; + nTot + &apos;  failed=&apos; + nErr + &apos;  DB-connection errors=&apos; + nDb
    checks &lt;&lt; [&apos;Performance test not failing on DB connections&apos;, &apos;DB-connection errors=&apos; + nDb, nDb == 0 ? &apos;OK&apos; : &apos;NOK&apos;]
    checks &lt;&lt; [&apos;Pod stop / restart test&apos;, &apos;NOT RUN - needs kubectl or DevOps&apos;, &apos;PENDING&apos;]

    boolean anyNok = checks.any { it[2] == &apos;NOK&apos; }
    String overall = anyNok ? &apos;FAIL - connections near the limit / not released, return to Dev with the CSV evidence&apos; :
                     (noMon ? &apos;INCOMPLETE - RDS monitor did not run&apos; : &apos;PASS (partial) - no leak seen; pod-stop test still pending&apos;)
    StringBuilder sb = new StringBuilder()
    sb.append(&apos;PLS-1115 - RDS connection release - test summary (&apos; + now() + &apos;)\n&apos;)
    sb.append(&apos;Environment: &apos; + P(&apos;env_name&apos;, &apos;QA2&apos;) + &apos;\n\n&apos;)
    lines.each { sb.append(it).append(&apos;\n&apos;) }
    sb.append(&apos;\nTicket point | Result | Status\n&apos;)
    checks.each { ch -&gt; sb.append(ch[0] + &apos; | &apos; + ch[1] + &apos; | &apos; + ch[2] + &apos;\n&apos;) }
    sb.append(&apos;\nOVERALL: &apos; + overall + &apos;\n&apos;)
    new File(resultsDir, &apos;PLS-1115_summary.txt&apos;).setText(sb.toString(), &apos;UTF-8&apos;)
    log.info(&apos;PLS-1115 summary:\n&apos; + sb)
    SampleResult.setResponseMessage(overall)
    SampleResult.setResponseData(sb.toString(), &apos;UTF-8&apos;)
    SampleResult.setSuccessful(!anyNok)
    return
}

SampleResult.setResponseMessage(&apos;Mode &apos; + MODE + &apos; skipped (pod tests need kubectl)&apos;)
SampleResult.setSuccessful(true)</samplerData>
</sample>
